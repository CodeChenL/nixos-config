config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd77:58a4:e94e::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.33.1'
	option netmask '255.255.255.0'
	list dns '223.5.5.5'
	list dns '114.114.114.114'

config interface 'wan'
	option device 'eth1'
	option proto 'pppoe'
	option username '@@OWRT_SECRET:WAN_PPPOE_USERNAME@@'
	option password '@@OWRT_SECRET:WAN_PPPOE_PASSWORD@@'
	option ipv6 'auto'
	list ip6class 'local'

config interface 'wan6'
	option device 'eth1'
	option proto 'dhcpv6'

config device
	option name 'eth1'
	option macaddr '88:C3:97:9B:92:03'

