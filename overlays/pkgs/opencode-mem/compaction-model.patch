+export async function resolveSessionModel(client, sessionID) {
+    const sessionClient = client?.session;
+    if (typeof sessionClient?.get !== "function")
+        return undefined;
+    try {
+        const response = await sessionClient.get({ path: { id: sessionID } });
+        if (response?.error)
+            return undefined;
+        const session = unwrapSdkData(response);
+        const model = session?.model;
+        if (typeof model?.providerID !== "string" || !model.providerID.trim() ||
+            typeof model?.id !== "string" || !model.id.trim())
+            return undefined;
+        return {
+            model: { providerID: model.providerID, modelID: model.id },
+            variant: typeof model.variant === "string" && model.variant
+                ? model.variant
+                : undefined,
+        };
+    }
+    catch (error) {
+        log("resolveSessionModel: session.get failed", { sessionID, error: String(error) });
+        return undefined;
