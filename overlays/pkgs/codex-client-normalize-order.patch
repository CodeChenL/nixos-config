+/// Moves existing outputs immediately after their matching calls.
+///
+/// Strict Responses providers require each tool call and its corresponding
+/// output to be adjacent. Hook-generated developer/user messages can otherwise
+/// land between them, so normalize the order before serializing the prompt.
+pub(crate) fn move_outputs_next_to_calls(items: &mut Vec<ResponseItemEnvelope>) {
+    let mut index = 0;
+    while index < items.len() {
+        let call_id = match &items[index].item {
+            ResponseItem::FunctionCall { call_id, .. }
+            | ResponseItem::CustomToolCall { call_id, .. } => Some(call_id.clone()),
+            ResponseItem::LocalShellCall {
+                call_id: Some(call_id),
+                ..
+            }
+            | ResponseItem::ToolSearchCall {
+                call_id: Some(call_id),
+                ..
+            } => Some(call_id.clone()),
+            _ => None,
+        };
+        let Some(call_id) = call_id else {
+            index += 1;
+            continue;
+        };
+
+        let relative = items[index + 1..]
+            .iter()
+            .position(|envelope| output_matches_call_id(&envelope.item, &call_id));
+        if let Some(relative) = relative {
+            let output = items.remove(index + 1 + relative);
+            items.insert(index + 1, output);
+        }
+        index += 1;
+    }
+}
+
+fn output_matches_call_id(item: &ResponseItem, call_id: &str) -> bool {
+    match item {
+        ResponseItem::FunctionCallOutput {
+            call_id: existing, ..
+        }
+        | ResponseItem::CustomToolCallOutput {
+            call_id: existing, ..
+        } => existing == call_id,
+        ResponseItem::ToolSearchOutput {
+            call_id: Some(existing),
+            ..
+        } => existing == call_id,
+        _ => false,
+    }
+}
