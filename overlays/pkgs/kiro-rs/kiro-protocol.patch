+    #[test]
+    fn effort_field_is_gated_by_model() {
+        let legacy = convert_request(&req(serde_json::json!({
+            "model": "claude-sonnet-4-5-20250929", "max_tokens": 1024,
+            "messages": [{"role": "user", "content": "hi"}],
+            "output_config": {"effort": "high"}
+        }))).unwrap();
+        assert!(legacy.additional_model_request_fields.is_none());
+
+        let opus46_enabled = convert_request(&req(serde_json::json!({
+            "model": "claude-opus-4-6", "max_tokens": 4096,
+            "messages": [{"role": "user", "content": "hi"}],
+            "thinking": {"type": "enabled", "budget_tokens": 2000},
+            "output_config": {"effort": "low"}
+        }))).unwrap();
+        assert!(opus46_enabled.additional_model_request_fields.is_none());
+
+        let opus46_adaptive = convert_request(&req(serde_json::json!({
+            "model": "claude-opus-4-6", "max_tokens": 4096,
+            "messages": [{"role": "user", "content": "hi"}],
+            "thinking": {"type": "adaptive"}
+        }))).unwrap();
+        assert_eq!(effort_of(&opus46_adaptive).as_deref(), Some("high"));
+
+        let sonnet46_budget = convert_request(&req(serde_json::json!({
+            "model": "claude-sonnet-4-6", "max_tokens": 16000,
+            "messages": [{"role": "user", "content": "hi"}],
