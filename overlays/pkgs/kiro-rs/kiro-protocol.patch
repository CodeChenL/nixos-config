+
+fn is_gpt_reasoning_model(model_id: &str) -> bool {
+    model_id.starts_with("gpt-5.6")
+}
+
+/// 上游 additionalModelRequestFields schema 只对这些模型开放 effort；
+/// sonnet/haiku/opus 4.5 与开放权重模型发送该字段会 400。
+fn supports_claude_effort(model_id: &str) -> bool {
+    matches!(
+        model_id,
+        "claude-opus-4.6" | "claude-opus-4.7" | "claude-opus-4.8" | "claude-sonnet-4.6"
+    ) || model_id.starts_with("claude-opus-5")
+        || model_id.starts_with("claude-sonnet-5")
+        || model_id.starts_with("claude-fable-")
+}
+
+fn supports_xhigh_effort(model_id: &str) -> bool {
+    matches!(model_id, "claude-opus-4.7" | "claude-opus-4.8")
+        || model_id.starts_with("claude-opus-5")
+        || model_id.starts_with("claude-sonnet-5")
+        || model_id.starts_with("claude-fable-")
+}
+
+fn effort_from_budget(budget_tokens: i32) -> &'static str {
+    match budget_tokens {
+        i32::MIN..=4_000 => "low",
+        4_001..=16_000 => "medium",
+        _ => "high",
+    }
+}
+
+fn build_additional_model_request_fields(
+    req: &MessagesRequest,
+    model_id: &str,
+) -> Option<AdditionalModelRequestFields> {
+    if req.thinking.as_ref().is_some_and(|t| t.thinking_type == "disabled") {
+        return None;
+    }
+    let explicit = req
+        .output_config
+        .as_ref()
+        .map(|oc| oc.effort.trim().to_ascii_lowercase())
+        .filter(|e| !e.is_empty());
+    let thinking = req.thinking.as_ref().filter(|t| t.is_enabled());
+
+    if is_gpt_reasoning_model(model_id) {
+        let effort = explicit.or_else(|| thinking.map(|_| "high".to_string()))?;
+        let effort = match effort.as_str() {
+            "max" => "xhigh".to_string(),
+            "low" | "medium" | "high" | "xhigh" => effort,
+            _ => "high".to_string(),
+        };
+        return Some(AdditionalModelRequestFields {
+            output_config: None,
+            reasoning: Some(KiroReasoningConfig { effort }),
+        });
+    }
+
+    if !supports_claude_effort(model_id) {
+        return None;
+    }
+    // Opus 4.6 仅在 adaptive thinking 下接受 output_config（enabled 或纯 effort 会 400）
+    if model_id == "claude-opus-4.6" && !thinking.is_some_and(|t| t.thinking_type == "adaptive") {
+        return None;
+    }
+    let effort = explicit.or_else(|| {
+        thinking.map(|t| {
+            if t.thinking_type == "enabled" {
+                effort_from_budget(t.budget_tokens).to_string()
+            } else {
+                "high".to_string()
+            }
+        })
+    })?;
+    let effort = match effort.as_str() {
+        "xhigh" if !supports_xhigh_effort(model_id) => "high".to_string(),
+        "low" | "medium" | "high" | "xhigh" | "max" => effort,
+        _ => "high".to_string(),
+    };
+    Some(AdditionalModelRequestFields {
+        output_config: Some(KiroOutputConfig { effort }),
+        reasoning: None,
+    })
+}
+
+fn max_output_tokens_cap(model_id: &str) -> i32 {
+    if matches!(model_id, "claude-opus-4.6" | "claude-opus-4.7" | "claude-opus-4.8")
+        || model_id.starts_with("claude-opus-5")
+        || model_id.starts_with("claude-sonnet-5")
+        || model_id.starts_with("claude-fable-")
+    {
+        128_000
+    } else {
+        64_000
+    }
+}
+
+/// Kiro 顶层 inferenceConfig（仅 Claude 系列）。thinking 生效或 adaptive-only 世代时
+/// 丢弃 temperature/topP：Anthropic 在这些情况下拒绝非默认采样参数（OmniRoute 报告 Kiro
+/// 上游同样 400）；本项目选择静默丢弃而非报错。
+///
+/// FIXME(max_tokens): 上游接受 maxTokens 但不遵守——实测 max_tokens=30 时 opus-5-5 与
+/// sonnet-4.5 仍输出约 340 token 且 stop_reason=end_turn。字段保留以便上游日后生效。
+fn build_inference_config(req: &MessagesRequest, model_id: &str) -> Option<InferenceConfig> {
+    if !model_id.starts_with("claude-") {
+        return None;
+    }
+    let max_tokens = Some(req.max_tokens.clamp(1, max_output_tokens_cap(model_id)));
+    let thinking_active = req.thinking.as_ref().is_some_and(|t| t.is_enabled());
+    let adaptive_only = matches!(model_id, "claude-opus-4.7" | "claude-opus-4.8")
+        || model_id.starts_with("claude-opus-5")
+        || model_id.starts_with("claude-sonnet-5")
+        || model_id.starts_with("claude-fable-");
+    let sampling_allowed = !thinking_active && !adaptive_only;
+    Some(InferenceConfig {
+        max_tokens,
+        temperature: req.temperature.filter(|_| sampling_allowed),
+        top_p: req.top_p.filter(|_| sampling_allowed),
+    })
+}
+
+/// Opus 4.5 与 4.6+ 世代跨回合保留历史 thinking；Sonnet/Haiku 4.5 及更早世代
+/// 只保留当前工具循环（最后一条真实 user 消息之后）的 thinking。
+fn model_preserves_prior_thinking(model_id: &str) -> bool {
+    !matches!(model_id, "claude-sonnet-4.5" | "claude-haiku-4.5" | "claude-sonnet-4.0")
+}
+
+fn is_real_user_turn(msg: &super::types::Message) -> bool {
+    match &msg.content {
+        serde_json::Value::Array(arr) => arr
+            .iter()
+            .any(|b| b.get("type").and_then(|t| t.as_str()) != Some("tool_result")),
+        _ => true,
+    }
+}
+
+fn strip_prior_turn_thinking(messages: &[super::types::Message]) -> Vec<super::types::Message> {
+    let boundary = messages
+        .iter()
+        .rposition(|m| m.role == "user" && is_real_user_turn(m))
+        .unwrap_or(0);
+    messages
+        .iter()
+        .enumerate()
+        .map(|(i, m)| {
+            let mut m = m.clone();
+            if i < boundary && m.role == "assistant" {
+                if let serde_json::Value::Array(arr) = &mut m.content {
+                    arr.retain(|b| {
+                        !matches!(
+                            b.get("type").and_then(|t| t.as_str()),
+                            Some("thinking") | Some("redacted_thinking")
+                        )
+                    });
+                    if arr.is_empty() {
+                        arr.push(serde_json::json!({"type": "text", "text": " "}));
+                    }
+                }
+            }
+            m
+        })
+        .collect()
+}
+
