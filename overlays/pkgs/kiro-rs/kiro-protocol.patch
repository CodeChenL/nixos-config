+/// 展开 error source 链（reqwest 的 Display 只给出 "error decoding response body"，
+/// 真实原因如连接重置 / h2 GOAWAY 在 source 中）
+fn error_chain(err: &dyn std::error::Error) -> String {
+    let mut parts = vec![err.to_string()];
+    let mut source = err.source();
+    while let Some(s) = source {
+        let msg = s.to_string();
+        if parts.last() != Some(&msg) {
+            parts.push(msg);
+        }
+        source = s.source();
+    }
+    parts.join(": ")
+}
