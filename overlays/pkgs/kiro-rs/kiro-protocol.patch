+        let xhigh_downgrade = convert_request(&req(serde_json::json!({
+            "model": "claude-sonnet-4-6", "max_tokens": 1024,
+            "messages": [{"role": "user", "content": "hi"}],
+            "output_config": {"effort": "xhigh"}
+        }))).unwrap();
+        assert_eq!(effort_of(&xhigh_downgrade).as_deref(), Some("high"));
