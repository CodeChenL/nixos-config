+/// 重试请求换一个新的 agentContinuationId（与每次正常请求一样随机生成，不与失败的那次共用）
+fn refresh_continuation_id(body: &str) -> String {
+    let Ok(mut value) = serde_json::from_str::<serde_json::Value>(body) else {
+        return body.to_string();
+    };
+    if let Some(state) = value.get_mut("conversationState").and_then(|s| s.as_object_mut()) {
+        if state.contains_key("agentContinuationId") {
+            state.insert("agentContinuationId".to_string(), serde_json::Value::String(Uuid::new_v4().to_string()));
+        }
+    }
+    serde_json::to_string(&value).unwrap_or_else(|_| body.to_string())
+}
