+    /// Check EOF completeness after draining all available frames.
+    pub fn finish(&self) -> ParseResult<()> {
+        let available = self.buffer.len();
+        if available == 0 {
+            return Ok(());
+        }
+        let needed = if available < PRELUDE_SIZE {
+            PRELUDE_SIZE
+        } else {
+            let length = u32::from_be_bytes([
+                self.buffer[0], self.buffer[1], self.buffer[2], self.buffer[3],
+            ]);
+            usize::try_from(length).map_err(|_| ParseError::MessageTooLarge {
+                length,
+                max: super::frame::MAX_MESSAGE_SIZE,
+            })?
+        };
+        Err(ParseError::Incomplete { needed, available })
+    }
