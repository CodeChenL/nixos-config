+            let text: String = events
+                .iter()
+                .filter_map(|event| event["delta"]["text"].as_str())
+                .collect();
+            assert!(!text.contains("trailing-frame-must-not-appear"));
+            assert!(!text.contains("corrupt-frame"));
+            assert_eq!(
+                events
+                    .iter()
+                    .filter(|event| event["type"] == "error")
+                    .count(),
+                1,
+                "{}",
+                observed.body
+            );
+            assert!(
+                !events.iter().any(
+                    |event| event["type"] == "message_delta" || event["type"] == "message_stop"
+                )
+            );
+            if let Some(block) = prefix {
+                assert!(
+                    events
+                        .iter()
+                        .any(|event| event["content_block"]["type"] == block),
+                    "{}",
+                    observed.body
+                );
+            } else {
+                assert!(
+                    !events
+                        .iter()
+                        .any(|event| event["type"] == "content_block_delta")
+                );
+            }
+            let terminal = events.last().unwrap();
+            assert_eq!(terminal["type"], "error");
+            assert_eq!(terminal["error"]["type"], "api_error");
+            terminal["error"]["message"].as_str().unwrap().to_string()
+        }
+    }
+}
