+
+#[derive(Clone, Copy)]
+enum Cut {
+    Prelude,
+    Payload,
+    Crc,
+}
+
+fn partial_frame(cut: Cut) -> Vec<u8> {
+    let payload = r#"{"content":"trailing-frame-must-not-appear"}"#;
+    let mut wire = frame(TEXT.0, payload);
+    assert!(matches!(parse_frame(&wire), Ok(Some(_))));
+    let end = match cut {
+        Cut::Prelude => PRELUDE_SIZE / 2,
+        Cut::Payload => wire.len() - 4 - payload.len() / 2,
+        Cut::Crc => wire.len() - 1,
+    };
+    wire.truncate(end);
+    assert!(matches!(parse_frame(&wire), Ok(None)));
+    wire
+}
+
+fn incomplete_wire(prefix: &[(&str, &str)], cut: Cut) -> Bytes {
+    let mut wire = body(prefix).to_vec();
+    wire.extend(partial_frame(cut));
+    Bytes::from(wire)
+}
+
