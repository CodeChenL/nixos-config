+    /// 仅针对 reasoningContentEvent 路径（旧式 `<thinking>` 标签路径不参与）。
+    pub fn is_reasoning_only_termination(&self) -> bool {
+        self.reasoning_seen
+            && self.upstream_error.is_none()
+            && !self.state_manager.has_tool_use
+            && !self.state_manager.has_non_thinking_blocks()
