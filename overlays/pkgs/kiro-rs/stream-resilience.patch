+#[tokio::test]
+async fn transport_completes_normally_when_eventstream_frame_incomplete() {
+    use axum::{Router, body::Body, routing::get};
+    use futures::stream;
+    use std::{convert::Infallible, time::Duration};
+    use tokio::{net::TcpListener, task::JoinSet};
+
+    let given = incomplete_wire(&[REASONING], Cut::Crc);
+    let chunks: Vec<_> = given.chunks(1).map(Bytes::copy_from_slice).collect();
+    let app =
+        Router::new().route(
+            "/",
+            get(move || {
+                let chunks = chunks.clone();
+                async move {
+                    Body::from_stream(stream::iter(chunks.into_iter().map(Ok::<_, Infallible>)))
+                }
+            }),
+        );
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let mut tasks = JoinSet::new();
+    tasks.spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .timeout(Duration::from_secs(3))
+        .build()
+        .unwrap();
+
+    let observed = client.get(url).send().await.unwrap().bytes().await.unwrap();
+
+    assert_eq!(observed, given);
+    tasks.shutdown().await;
+}
