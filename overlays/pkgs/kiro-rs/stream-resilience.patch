@@ -0,0 +1,234 @@
+use super::frame_error_tests::wire::bad_crc_frame;
+use super::malformed_event_fixture as fixture;
+use bytes::Bytes;
+use fixture::{Mode, Observed, Script, frame, raw_frame};
+use reqwest::StatusCode;
+use serde_json::Value;
+
+use crate::kiro::model::events::Event;
+use crate::kiro::parser::{decoder::EventStreamDecoder, error::ParseError, frame::parse_frame};
+
+const PAYLOAD: &str = r#"{"message":"slowdown"}"#;
+const LATER: &str = "trailing-frame-must-not-appear";
+
+#[derive(Clone, Copy)]
+enum Kind {
+    Error,
+    Exception,
+}
+
+#[derive(Clone, Copy)]
+enum Cause {
+    Throttle,
+    Api,
+    Overload,
+}
+
+impl Cause {
+    const fn code(self) -> &'static str {
+        match self {
+            Self::Throttle => "ThrottlingException",
+            Self::Api => "InternalFailure",
+            Self::Overload => "ServiceUnavailableException",
+        }
+    }
+
+    const fn class(self) -> &'static str {
+        match self {
+            Self::Throttle => "rate_limit_error",
+            Self::Api => "api_error",
+            Self::Overload => "overloaded_error",
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+enum Fault {
+    Payload,
+    Crc,
+}
+
+fn upstream_frame(kind: Kind, cause: Cause) -> Vec<u8> {
+    let (message_type, code_header) = match kind {
+        Kind::Error => ("error", ":error-code"),
+        Kind::Exception => ("exception", ":exception-type"),
+    };
+    raw_frame(
+        &[
+            (":message-type", message_type),
+            (code_header, cause.code()),
+            (":content-type", "application/json"),
+        ],
+        PAYLOAD,
+    )
+}
+
+fn fault_frame(fault: Fault) -> Vec<u8> {
+    match fault {
+        Fault::Payload => frame("toolUseEvent", "{"),
+        Fault::Crc => bad_crc_frame(),
+    }
+}
+
+fn wire(kind: Kind, cause: Cause, fault: Fault) -> Bytes {
+    let mut wire = upstream_frame(kind, cause);
+    wire.extend(fault_frame(fault));
+    wire.extend(frame(
+        "assistantResponseEvent",
+        &format!(r#"{{"content":"{LATER}"}}"#),
+    ));
+    Bytes::from(wire)
+}
+
+fn assert_preserved(observed: &Observed, mode: Mode, cause: Cause) {
+    assert_eq!(observed.requests.len(), 1, "first errors must not retry");
+    assert!(!observed.body.contains(LATER), "{}", observed.body);
+    let error = match mode {
+        Mode::NonStream => {
+            let expected_status = match cause {
+                Cause::Throttle => StatusCode::TOO_MANY_REQUESTS,
+                Cause::Api | Cause::Overload => StatusCode::BAD_GATEWAY,
+            };
+            assert_eq!(observed.status, expected_status, "{}", observed.body);
+            let response: Value = serde_json::from_str(&observed.body).unwrap();
+            assert_eq!(
+                response.as_object().unwrap().keys().collect::<Vec<_>>(),
+                vec!["error"]
+            );
+            response["error"].clone()
+        }
+        Mode::Normal | Mode::Buffered => {
+            assert_eq!(observed.status, StatusCode::OK);
+            let events: Vec<Value> = observed
+                .body
+                .lines()
+                .filter_map(|line| line.strip_prefix("data: "))
+                .map(|data| serde_json::from_str(data).unwrap())
+                .collect();
+            assert_eq!(
+                events
+                    .iter()
+                    .filter(|event| event["type"] == "error")
+                    .count(),
+                1
+            );
+            assert!(
+                !events.iter().any(|event| {
+                    event["type"] == "message_delta"
+                        || event["type"] == "message_stop"
+                        || event["type"] == "content_block_delta"
+                }),
+                "{}",
+                observed.body
+            );
+            let terminal = events.last().unwrap();
+            assert_eq!(terminal["type"], "error");
+            terminal["error"].clone()
+        }
+    };
+    assert_eq!(error["type"], cause.class(), "{}", observed.body);
+    assert_eq!(
+        error["message"],
+        format!("{}: {PAYLOAD}", cause.code()),
+        "{}",
+        observed.body
+    );
+}
+
+macro_rules! http_cases {
+    ($kind:ident, $cause:ident; $($name:ident, $mode:ident, $fault:ident, $split:expr);* $(;)?) => {$ (
+        #[tokio::test]
+        async fn $name() {
+            let given = Script {
+                bodies: vec![wire(Kind::$kind, Cause::$cause, Fault::$fault)], keep_open: false,
+            };
+            let observed = fixture::run_chunks(given, Mode::$mode, $split).await;
+            assert_preserved(&observed, Mode::$mode, Cause::$cause);
+        }
+    )*};
+}
+
+macro_rules! cause_cases {
+    ($module:ident, $kind:ident, $cause:ident) => {
+        mod $module {
+            use super::*;
+
+            #[test]
+            fn fixture_parses_cause_when_frame_complete_or_byte_split() {
+                let given = upstream_frame(Kind::$kind, Cause::$cause);
+                let (parsed, consumed) = parse_frame(&given).unwrap().unwrap();
+                assert_eq!(consumed, given.len());
+                let observed = Event::from_frame(parsed).unwrap();
+                match observed {
+                    Event::Error {
+                        error_code,
+                        error_message,
+                    } => {
+                        assert!(matches!(Kind::$kind, Kind::Error));
+                        assert_eq!(error_code, Cause::$cause.code());
+                        assert_eq!(error_message, PAYLOAD);
+                    }
+                    Event::Exception {
+                        exception_type,
+                        message,
+                    } => {
+                        assert!(matches!(Kind::$kind, Kind::Exception));
+                        assert_eq!(exception_type, Cause::$cause.code());
+                        assert_eq!(message, PAYLOAD);
+                    }
+                    Event::AssistantResponse(_)
+                    | Event::ToolUse(_)
+                    | Event::Metering(_)
+                    | Event::Metadata(_)
+                    | Event::ContextUsage(_)
+                    | Event::ReasoningContent(_)
+                    | Event::Unknown {} => panic!("fixture must parse as Error/Exception"),
+                }
+                let mut decoder = EventStreamDecoder::new();
+                for byte in &given[..given.len() - 1] {
+                    decoder.feed(&[*byte]).unwrap();
+                    assert!(decoder.decode_iter().next().is_none());
+                }
+                decoder.feed(&given[given.len() - 1..]).unwrap();
+                let decoded = decoder
+                    .decode_iter()
+                    .collect::<Result<Vec<_>, _>>()
+                    .unwrap();
+                assert_eq!(decoded.len(), 1);
+                Event::from_frame(decoded.into_iter().next().unwrap()).unwrap();
+                decoder.finish().unwrap();
+            }
+
+            http_cases! {
+                $kind, $cause;
+                normal_preserves_when_payload_malformed, Normal, Payload, None;
+                buffered_preserves_when_payload_malformed, Buffered, Payload, None;
+                non_stream_preserves_when_payload_malformed, NonStream, Payload, None;
+                normal_preserves_when_crc_corrupt, Normal, Crc, None;
+                buffered_preserves_when_crc_corrupt, Buffered, Crc, None;
+                non_stream_preserves_when_crc_corrupt, NonStream, Crc, None;
+                normal_preserves_when_payload_byte_split, Normal, Payload, Some(1);
+                buffered_preserves_when_payload_byte_split, Buffered, Payload, Some(1);
+                non_stream_preserves_when_payload_byte_split, NonStream, Payload, Some(1);
+                normal_preserves_when_crc_byte_split, Normal, Crc, Some(1);
+                buffered_preserves_when_crc_byte_split, Buffered, Crc, Some(1);
+                non_stream_preserves_when_crc_byte_split, NonStream, Crc, Some(1);
+            }
+        }
+    };
+}
+
+cause_cases!(throttle_error, Error, Throttle);
+cause_cases!(throttle_exception, Exception, Throttle);
+cause_cases!(api_error, Error, Api);
+cause_cases!(overloaded_exception, Exception, Overload);
+
+#[test]
+fn fixture_has_semantic_error_when_recognized_payload_crc_valid() {
+    let given = fault_frame(Fault::Payload);
+    let (parsed, consumed) = parse_frame(&given).unwrap().unwrap();
+    assert_eq!(consumed, given.len());
+    assert_eq!(parsed.event_type(), Some("toolUseEvent"));
+    let observed = Event::from_frame(parsed);
+    assert!(matches!(observed, Err(ParseError::PayloadDeserialize(_))));
+}
