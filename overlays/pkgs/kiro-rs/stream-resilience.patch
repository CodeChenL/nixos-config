+pub fn bad_crc_frame() -> Vec<u8> {
+    let mut wire = frame("assistantResponseEvent", r#"{"content":"corrupt-frame"}"#);
+    let total = wire.len();
+    wire[total - 1] ^= 1;
+    assert_eq!(
+        usize::try_from(u32::from_be_bytes(wire[..4].try_into().unwrap())).unwrap(),
+        total
+    );
+    let headers = usize::try_from(u32::from_be_bytes(wire[4..8].try_into().unwrap())).unwrap();
+    assert_eq!(16 + headers + r#"{"content":"corrupt-frame"}"#.len(), total);
+    assert_eq!(
+        crc32(&wire[..8]),
+        u32::from_be_bytes(wire[8..12].try_into().unwrap())
+    );
+    assert!(matches!(
+        parse_frame(&wire),
+        Err(ParseError::MessageCrcMismatch { .. })
+    ));
+    wire
+}
+
+pub fn corrupt_wire(prefix: &[(&str, &str)]) -> Bytes {
+    let mut wire = body(prefix).to_vec();
+    wire.extend(bad_crc_frame());
+    wire.extend(body(&[LATER]));
+    Bytes::from(wire)
+}
+
+pub fn overflow_wire() -> Bytes {
+    let mut wire = body(&[TEXT]).to_vec();
+    wire.resize(DEFAULT_MAX_BUFFER_SIZE + 1, 0);
+    let mut decoder = EventStreamDecoder::new();
+    assert!(
+        matches!(decoder.feed(&wire), Err(ParseError::BufferOverflow { size, max })
+        if size == DEFAULT_MAX_BUFFER_SIZE + 1 && max == DEFAULT_MAX_BUFFER_SIZE)
+    );
+    Bytes::from(wire)
+}
