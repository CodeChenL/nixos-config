+++ b/src/anthropic/malformed_event_fixture.rs
@@ -0,0 +1,213 @@
+use std::collections::HashMap;
+use std::convert::Infallible;
+use std::sync::Arc;
+use std::time::Duration;
+
+use axum::{Json, Router, body::Body, routing::post};
+use bytes::Bytes;
+use futures::{StreamExt, stream};
+use parking_lot::Mutex;
+use reqwest::{RequestBuilder, StatusCode};
+use serde_json::{Value, json};
+use tokio::{net::TcpListener, task::JoinSet};
+
+use crate::anthropic::router::create_router_with_provider;
+use crate::kiro::endpoint::{KiroEndpoint, RequestContext};
+use crate::kiro::model::credentials::KiroCredentials;
+use crate::kiro::parser::{crc::crc32, decoder::EventStreamDecoder};
+use crate::kiro::provider::KiroProvider;
+use crate::kiro::token_manager::MultiTokenManager;
+use crate::model::config::Config;
+
+pub enum Mode {
+    Normal,
+    Buffered,
+    NonStream,
+}
+
+pub struct Script {
+    pub bodies: Vec<Bytes>,
+    pub keep_open: bool,
+}
+
+pub struct Observed {
+    pub status: StatusCode,
+    pub body: String,
+    pub requests: Vec<Value>,
+}
+
+struct LoopbackEndpoint(String);
+
+impl KiroEndpoint for LoopbackEndpoint {
+    fn name(&self) -> &'static str {
+        "loopback"
+    }
+
+    fn api_url(&self, _ctx: &RequestContext<'_>) -> String {
+        self.0.clone()
+    }
+
+    fn mcp_url(&self, _ctx: &RequestContext<'_>) -> String {
+        panic!("MCP is outside this fixture")
+    }
+
+    fn decorate_api(&self, request: RequestBuilder, _ctx: &RequestContext<'_>) -> RequestBuilder {
+        request
+    }
+
+    fn decorate_mcp(&self, _request: RequestBuilder, _ctx: &RequestContext<'_>) -> RequestBuilder {
+        panic!("MCP is outside this fixture")
+    }
+
+    fn transform_api_body(&self, body: &str, _ctx: &RequestContext<'_>) -> String {
+        body.to_string()
+    }
+}
+
+pub fn frame(event_type: &str, payload: &str) -> Vec<u8> {
+    raw_frame(
+        &[
+            (":message-type", "event"),
+            (":event-type", event_type),
+            (":content-type", "application/json"),
+        ],
+        payload,
+    )
+}
+
+pub fn raw_frame(fields: &[(&str, &str)], payload: &str) -> Vec<u8> {
+    let mut headers = Vec::new();
+    for (name, value) in fields {
+        headers.push(u8::try_from(name.len()).unwrap());
+        headers.extend_from_slice(name.as_bytes());
+        headers.push(7);
+        headers.extend_from_slice(&u16::try_from(value.len()).unwrap().to_be_bytes());
+        headers.extend_from_slice(value.as_bytes());
+    }
+    let mut wire = Vec::new();
+    wire.extend_from_slice(
+        &u32::try_from(16 + headers.len() + payload.len())
+            .unwrap()
+            .to_be_bytes(),
+    );
+    wire.extend_from_slice(&u32::try_from(headers.len()).unwrap().to_be_bytes());
+    wire.extend_from_slice(&crc32(&wire).to_be_bytes());
+    wire.extend_from_slice(&headers);
+    wire.extend_from_slice(payload.as_bytes());
+    wire.extend_from_slice(&crc32(&wire).to_be_bytes());
+    wire
+}
+
+pub fn body(events: &[(&str, &str)]) -> Bytes {
+    let wire: Vec<u8> = events
+        .iter()
+        .flat_map(|(kind, payload)| frame(kind, payload))
+        .collect();
+    let mut decoder = EventStreamDecoder::new();
+    decoder.feed(&wire).unwrap();
+    let decoded = decoder
+        .decode_iter()
+        .collect::<Result<Vec<_>, _>>()
+        .unwrap();
+    assert_eq!(decoded.len(), events.len(), "fixture framing must be valid");
+    Bytes::from(wire)
+}
+
+async fn serve(tasks: &mut JoinSet<()>, app: Router) -> String {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    tasks.spawn(async move { axum::serve(listener, app).await.unwrap() });
+    url
+}
+
+pub async fn run(script: Script, mode: Mode) -> Observed {
+    run_chunks(script, mode, None).await
+}
+
+pub async fn run_chunks(script: Script, mode: Mode, chunk_size: Option<usize>) -> Observed {
+    let mut tasks = JoinSet::new();
+    let requests = Arc::new(Mutex::new(Vec::new()));
+    let recorded = requests.clone();
+    let upstream = Router::new().route(
+        "/upstream",
+        post(move |Json(request): Json<Value>| {
+            let response_body = {
+                let mut recorded = recorded.lock();
+                let index = recorded.len().min(script.bodies.len() - 1);
+                recorded.push(request);
+                script.bodies[index].clone()
+            };
+            async move {
+                let chunks = match chunk_size {
+                    Some(size) => response_body
+                        .chunks(size)
+                        .map(Bytes::copy_from_slice)
+                        .collect(),
+                    None => vec![response_body],
+                };
+                let chunk = stream::iter(chunks.into_iter().map(Ok::<_, Infallible>));
+                let response_body = match script.keep_open {
+                    true => Body::from_stream(chunk.chain(stream::pending())),
+                    false => Body::from_stream(chunk),
+                };
+                (
+                    [("content-type", "application/vnd.amazon.eventstream")],
+                    response_body,
+                )
+            }
+        }),
+    );
+    let upstream_url = serve(&mut tasks, upstream).await;
+    let credentials = KiroCredentials {
+        id: Some(1),
+        auth_method: Some("api_key".to_string()),
+        kiro_api_key: Some("local-fixture-only".to_string()),
+        machine_id: Some("0".repeat(64)),
+        ..Default::default()
+    };
+    let manager =
+        MultiTokenManager::new(Config::default(), vec![credentials], None, None, false).unwrap();
+    let endpoint: Arc<dyn KiroEndpoint> =
+        Arc::new(LoopbackEndpoint(format!("{upstream_url}/upstream")));
+    let endpoints = HashMap::from([(endpoint.name().to_string(), endpoint)]);
+    let provider =
+        KiroProvider::with_proxy(Arc::new(manager), None, endpoints, "loopback".to_string());
+    let downstream_url = serve(
+        &mut tasks,
+        create_router_with_provider("fixture-key", Some(provider), true),
+    )
+    .await;
+    let (path, streaming) = match mode {
+        Mode::Normal => ("/v1/messages", true),
+        Mode::Buffered => ("/cc/v1/messages", true),
+        Mode::NonStream => ("/v1/messages", false),
+    };
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .timeout(Duration::from_secs(3))
+        .build()
+        .unwrap();
+    let response = client
+        .post(format!("{downstream_url}{path}"))
+        .header("x-api-key", "fixture-key")
+        .json(&json!({
+            "model": "claude-sonnet-4-5", "max_tokens": 64, "stream": streaming,
+            "thinking": { "type": "enabled", "budget_tokens": 1024 },
+            "messages": [{ "role": "user", "content": "fixture" }]
+        }))
+        .send()
+        .await
+        .unwrap();
+    let status = response.status();
+    let body = response
+        .text()
+        .await
+        .expect("downstream must terminate without waiting for upstream EOF");
+    let requests = requests.lock().clone();
+    tasks.shutdown().await;
+    Observed {
+        status,
+        body,
+        requests,
+    }
+}
