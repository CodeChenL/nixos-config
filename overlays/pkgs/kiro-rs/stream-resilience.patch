+/// 解析上游帧，保留事件类型与解析错误供响应处理层终止请求。
+fn decode_event(frame: crate::kiro::parser::frame::Frame) -> Result<Event, Error> {
+    let event_type = frame.event_type().unwrap_or("unknown").to_string();
+    Event::from_frame(frame).map_err(|error| {
+        Error::new(error).context(format!("invalid upstream {event_type} payload"))
+    })
+}
