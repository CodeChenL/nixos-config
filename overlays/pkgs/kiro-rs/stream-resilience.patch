+use super::{crc::crc32, decoder::EventStreamDecoder, error::ParseError, frame::PRELUDE_SIZE};
+
+fn frame(payload: &[u8]) -> Vec<u8> {
+    let mut wire = Vec::new();
+    wire.extend_from_slice(&u32::try_from(16 + payload.len()).unwrap().to_be_bytes());
+    wire.extend_from_slice(&0u32.to_be_bytes());
+    wire.extend_from_slice(&crc32(&wire).to_be_bytes());
+    wire.extend_from_slice(payload);
+    wire.extend_from_slice(&crc32(&wire).to_be_bytes());
+    wire
+}
+
+#[test]
+fn finish_succeeds_when_stream_empty() {
+    let given = EventStreamDecoder::new();
+    let observed = given.finish();
+    assert!(observed.is_ok());
+}
+
+#[test]
+fn finish_succeeds_when_complete_empty_frame_drained() {
+    let mut given = EventStreamDecoder::new();
+    given.feed(&frame(&[])).unwrap();
+    let frames = given.decode_iter().collect::<Result<Vec<_>, _>>().unwrap();
+    assert_eq!(frames.len(), 1);
+    let observed = given.finish();
+    assert!(observed.is_ok());
+}
+
+macro_rules! incomplete_tests {
+    ($($name:ident, $available:expr, $needed:expr);* $(;)?) => {$ (
+        #[test]
+        fn $name() {
+            let wire = frame(b"payload");
+            let mut given = EventStreamDecoder::new();
+            given.feed(&wire[..$available]).unwrap();
+            assert!(given.decode_iter().next().is_none());
+            let observed = given.finish();
+            assert!(matches!(observed, Err(ParseError::Incomplete { needed, available })
+                if needed == $needed && available == $available));
+        }
+    )*};
+}
+
+incomplete_tests! {
+    finish_rejects_when_half_prelude, 6, PRELUDE_SIZE;
+    finish_rejects_when_partial_payload, PRELUDE_SIZE + 3, 23;
+    finish_rejects_when_crc_byte_missing, 22, 23;
+}
+
+#[test]
+fn finish_rejects_when_any_nonempty_frame_prefix_remaining() {
+    let wire = frame(b"payload");
+    for available in 1..wire.len() {
+        let mut given = EventStreamDecoder::new();
+        given.feed(&wire[..available]).unwrap();
+        assert!(given.decode_iter().next().is_none());
+        let observed = given.finish();
+        let expected = if available < PRELUDE_SIZE {
+            PRELUDE_SIZE
+        } else {
+            wire.len()
+        };
+        assert!(
+            matches!(observed, Err(ParseError::Incomplete { needed, available: actual })
+            if needed == expected && actual == available)
+        );
+    }
+}
+
+#[test]
+fn decoding_continues_when_missing_bytes_fed_after_finish_error() {
+    let wire = frame(b"payload");
+    let mut given = EventStreamDecoder::new();
+    given.feed(&wire[..wire.len() - 1]).unwrap();
+    assert!(given.decode_iter().next().is_none());
+    assert!(matches!(given.finish(), Err(ParseError::Incomplete { .. })));
+
+    given.feed(&wire[wire.len() - 1..]).unwrap();
+
+    let frames = given.decode_iter().collect::<Result<Vec<_>, _>>().unwrap();
+    assert_eq!(frames.len(), 1);
+    assert_eq!(frames[0].payload, b"payload");
+    assert!(given.finish().is_ok());
+}
+
+#[test]
+fn recovery_continues_when_crc_error_precedes_clean_boundary() {
+    let mut corrupt = frame(b"corrupt");
+    *corrupt.last_mut().unwrap() ^= 1;
+    corrupt.extend(frame(b"valid"));
+    let mut given = EventStreamDecoder::new();
+    given.feed(&corrupt).unwrap();
+    assert!(matches!(
+        given.decode_iter().next(),
+        Some(Err(ParseError::MessageCrcMismatch { .. }))
+    ));
+
+    given.feed(&[]).unwrap();
+
+    let frames = given.decode_iter().collect::<Result<Vec<_>, _>>().unwrap();
+    assert_eq!(frames.len(), 1);
+    assert_eq!(frames[0].payload, b"valid");
+    assert!(given.finish().is_ok());
+}
