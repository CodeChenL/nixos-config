+/// 上游错误码 → Anthropic error.type（限流类映射为 rate_limit_error 便于客户端退避重试）
+pub fn upstream_error_type(code: &str) -> &'static str {
+    let lower = code.to_lowercase();
+    if lower.contains("throttl") || lower.contains("toomanyrequests") || lower.contains("quota") {
+        "rate_limit_error"
+    } else if lower.contains("overloaded") || lower.contains("serviceunavailable") || lower.contains("capacity") {
+        "overloaded_error"
+    } else {
+        "api_error"
+    }
+}
